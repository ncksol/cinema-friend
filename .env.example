# Cinema Friend configuration.
#
# Copy this file, fill it in, and lock it down:
#
#   cp .env.example ~/.config/cinema-friend/cinema-friend.env
#   chmod 600 ~/.config/cinema-friend/cinema-friend.env
#
# The service refuses to start if this file is readable by group or others, because it
# holds a bot token. Values are read literally: do not quote them, and do not put a
# comment on the end of a value line.

# From @BotFather. Anyone holding this string can act as the bot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleReplaceThisWithYourRealToken

# Comma-separated numeric Telegram user IDs allowed to talk to the bot. Everyone else is
# ignored. Ask @userinfobot for yours. This is the only access control there is, so keep
# it to the people who should see your watches.
TELEGRAM_ALLOWED_USER_IDS=11111111,22222222

# SQLite database holding watches, results and notification history. It is created on
# first run, along with any missing parent directories. Prefer a path without spaces.
DATABASE_PATH=~/.local/state/cinema-friend/cinema-friend.db

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs are JSON, one object per line, with the
# bot token and BFI URL tokens redacted.
LOG_LEVEL=INFO

# The curl_cffi browser profile used to talk to BFI. Change it only if the smoke test
# starts failing on a challenge; "chrome" is the profile the site is verified against.
# There is deliberately no User-Agent setting: the profile supplies a coherent header
# set, and overriding one header inside it would break the fingerprint.
BFI_IMPERSONATE_PROFILE=chrome
